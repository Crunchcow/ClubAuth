# Django
SECRET_KEY=aendern-zu-einem-zufaelligen-50-zeichen-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# OIDC RSA-Schlüssel (Datei-Pfad, relativ zum Projektverzeichnis)
# Erzeugen mit:  openssl genrsa -out private.pem 2048
# private.pem nie ins Git committen!
OIDC_RSA_PRIVATE_KEY_FILE=private.pem

# Microsoft-Login (optional – leer lassen, wenn nicht gewünscht)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
